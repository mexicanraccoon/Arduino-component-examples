

const int potPin = A0;
const int buzzPin = 9;

int freq = 0;
int potVal = 0;


void setup() {
  // put your setup code here, to run once:
  Serial.begin(9600);

}

void loop() {
  // put your main code here, to run repeatedly:
  potVal = analogRead(potPin);
  freq = map(potVal, 0, 1023, 100, 1500);
  Serial.println(freq);

  tone(buzzPin, freq);
  delay(3);

}
